{
  "expo": {
    "name": "Kasama",
    "slug": "kasama",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jaypee.kasama",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow $(PRODUCT_NAME) to use speech recognition.",
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to use the microphone."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0e1428",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.jaypee.kasama",
      "permissions": [
        "SCHEDULE_EXACT_ALARM",
        "POST_NOTIFICATIONS",
        "com.android.alarm.permission.SET_ALARM",
        "android.permission.READ_CALENDAR",
        "android.permission.RECORD_AUDIO",
        "android.permission.WRITE_CALENDAR",
        "SCHEDULE_EXACT_ALARM",
        "POST_NOTIFICATIONS",
        "com.android.alarm.permission.SET_ALARM",
        "android.permission.READ_CALENDAR",
        "android.permission.RECORD_AUDIO",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "kasama",
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#557564"
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#f6f0e4"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Kasama listens only after you tap the mic, to turn your words into text.",
          "speechRecognitionPermission": "Kasama turns what you say into text.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.tts",
            "com.google.android.as"
          ]
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Kasama checks when you are busy so it can plan around your meetings. Event names stay on your phone.",
          "remindersPermission": false
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b52e1ba9-27f3-4992-b177-51130606cbda"
      }
    },
    "owner": "jypeejypee",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b52e1ba9-27f3-4992-b177-51130606cbda"
    }
  }
}
