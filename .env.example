# Copy to .env (Expo reads it automatically). Only EXPO_PUBLIC_ values reach the app.
# Your Supabase Edge Function URL (see README step 3)
EXPO_PUBLIC_ASSISTANT_URL=https://YOUR-PROJECT.supabase.co/functions/v1/assistant
# Must match the APP_SECRET you set on the function. Only a speed bump: it ships inside the app.
EXPO_PUBLIC_APP_SECRET=choose-a-long-random-text
# Supabase → Project Settings → API → anon / publishable key. Public by design: each phone uses it to sign in
# anonymously, and the backend gives every phone its own daily limit.
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
